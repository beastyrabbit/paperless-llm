{
  "name": "paperless-local-llm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "portless proxy start --port 1355 --https && pnpm run dev:portless",
    "dev:web": "pnpm --filter @repo/api-contracts build && PORT=3765 pnpm --filter @repo/web dev",
    "dev:backend": "pnpm --filter @repo/api-contracts build && PORT=8765 pnpm --filter @repo/backend dev",
    "dev:parallel": "concurrently -n backend,web -c cyan,magenta \"pnpm dev:backend\" \"pnpm dev:web\"",
    "dev:web:portless": "pnpm --filter @repo/api-contracts build && BACKEND_URL=https://paperless-llm-api.localhost:1355 portless paperless-llm-web pnpm --filter @repo/web dev",
    "dev:backend:portless": "pnpm --filter @repo/api-contracts build && portless paperless-llm-api pnpm --filter @repo/backend dev",
    "dev:portless": "concurrently -n backend,web -c cyan,magenta \"pnpm dev:backend:portless\" \"pnpm dev:web:portless\"",
    "migrate": "pnpm exec tsx scripts/migrate-to-tinybase.ts",
    "migrate:dry-run": "pnpm exec tsx scripts/migrate-to-tinybase.ts --dry-run",
    "lint": "biome lint --diagnostic-level=warn --error-on-warnings .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "format": "biome check --write .",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "precommit": "pnpm run typecheck && pnpm run lint",
    "check:ref-artifacts": "sh scripts/check-ref-artifacts.sh",
    "demo:record": "bunx tsx scripts/record-demo.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.6.0",
    "concurrently": "^10.0.0",
    "lefthook": "^2.1.6",
    "playwright": "^1.57.0",
    "tsx": "^4.21.0",
    "turbo": "^2.7.3"
  },
  "packageManager": "pnpm@9.15.0"
}
