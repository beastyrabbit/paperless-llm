{
  "name": "paperless-local-llm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0"
  },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "dev": "tsx watch src/cli.ts serve",
    "start": "node dist/cli.js serve",
    "cli": "tsx src/cli.ts",
    "lint": "biome check --error-on-warnings src tests vitest.config.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "format": "biome check --write src tests vitest.config.ts",
    "precommit": "pnpm run typecheck && pnpm run lint",
    "check:ref-artifacts": "sh scripts/check-ref-artifacts.sh",
    "check:artifact": "node scripts/verify-artifact.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.6",
    "lefthook": "^2.1.6",
    "node-gyp": "^13.1.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "better-sqlite3": "^13.2.0",
    "hono": "^4.13.19",
    "htmx.org": "^2.0.11",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
