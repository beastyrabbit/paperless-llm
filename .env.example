# Paperless Local LLM - Environment Variables
# Copy this file to .env and configure your values

# ===========================================
# Paperless-ngx Connection
# ===========================================
PAPERLESS_URL=https://paperless.example.com
# Startup-only secret; inject with Infisical. The settings GUI cannot change it.
PAPERLESS_TOKEN=your-paperless-api-token

# ===========================================
# Mistral AI (OCR)
# ===========================================
# Startup-only secret; inject with Infisical. The settings GUI cannot change it.
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-ocr-latest
MISTRAL_API_BASE_URL=https://api.mistral.ai

# ===========================================
# Ollama (Local LLM)
# ===========================================
# Inject the same reachable endpoint contract through Infisical in dev and prod.
OLLAMA_URL=http://ollama.internal.example:11434
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:8b

# ===========================================
# Qdrant (Vector Database)
# ===========================================
# Inject the same reachable endpoint contract through Infisical in dev and prod.
QDRANT_URL=http://qdrant.internal.example:6333
QDRANT_COLLECTION=paperless-documents
QDRANT_EMBEDDING_DIMENSION=4096

# ===========================================
# Paperless-first Cutover
# ===========================================
PAPERLESS_LLM_MUTATION_MODE=paperless_first
# Keep disabled for manual workbench testing; use canary/all only after review.
PAPERLESS_LLM_AI_ANALYSE_SCANNER_SCOPE=disabled
PAPERLESS_LLM_AI_ANALYSE_TAG_ID=115

# ===========================================
# CORS (Frontend URL)
# ===========================================
# Comma-separated list of allowed browser origins for direct backend access.
# Local development also allows these origins by default outside NODE_ENV=production.
PAPERLESS_LLM_TRUSTED_UI_ORIGINS=https://paperless-llm-web.localhost:1355,http://localhost:3765,http://127.0.0.1:3765
# Legacy alias still supported: CORS_ORIGINS=http://localhost:3765,http://127.0.0.1:3765

# ===========================================
# Optional Settings
# ===========================================
# DEBUG=true
# LOG_LEVEL=INFO

# ===========================================
# Container Deployment / Secrets
# ===========================================
# Local development can leave provider secrets empty. Production compose defaults
# this to true when the variable is unset.
PAPERLESS_LLM_REQUIRE_SECRETS=false
# Shared token used by the web proxy or direct clients to authenticate to the backend.
PAPERLESS_LLM_API_TOKEN=
# Restrict outbound Paperless calls in sensitive deployments.
PAPERLESS_ALLOWED_HOSTS=

# ===========================================
# Codex Runtime
# ===========================================
# The backend image installs @openai/codex pinned by CODEX_CLI_VERSION at build time.
CODEX_CLI_VERSION=0.145.0
# Docker Compose persists /app/codex-home as the backend-codex-home volume.
# CODEX_HOME=/app/codex-home
# Leave disabled until auth.json has been mounted or created in CODEX_HOME.
PAPERLESS_LLM_CODEX_ENABLED=false
PAPERLESS_LLM_CODEX_AUTH_REQUIRED=false
PAPERLESS_LLM_MISTRAL_ENABLED=false
PAPERLESS_LLM_MISTRAL_AUTH_REQUIRED=false
PAPERLESS_LLM_AGENT_PROMPT_TIMEOUT_MS=120000

# ===========================================
# Operational Ledger / Local State
# ===========================================
# Docker Compose sets these to /app/data/... inside the backend container.
# PAPERLESS_LLM_TINYBASE_DATA_DIR=/app/data/tinybase
# PAPERLESS_LLM_OPERATIONAL_LEDGER_DATA_DIR=/app/data/operational-ledger
PAPERLESS_LLM_BACKEND_WRITER_LOCK_ENABLED=true
PAPERLESS_LLM_CONTAINER_CHECKS_ENABLED=true

# ===========================================
# HTTP Rate Limiting
# ===========================================
PAPERLESS_LLM_RATE_LIMIT_ENABLED=true
PAPERLESS_LLM_RATE_LIMIT_WINDOW_MS=60000
PAPERLESS_LLM_RATE_LIMIT_MAX_REQUESTS=300
PAPERLESS_LLM_RATE_LIMIT_TRUST_PROXY=false

# ===========================================
# Runtime Timeouts / Concurrency
# ===========================================
PAPERLESS_LLM_HTTP_TIMEOUT_MS=120000
PAPERLESS_LLM_MISTRAL_RETRY_ATTEMPTS=3
PAPERLESS_LLM_MISTRAL_RETRY_BASE_DELAY_MS=5000
PAPERLESS_LLM_OLLAMA_MAX_CONCURRENT=1
PAPERLESS_LLM_MISTRAL_MAX_CONCURRENT=1
PAPERLESS_LLM_OCR_MAX_CONCURRENT=1

# ===========================================
# OCR Budget Caps (0/unset = unlimited)
# ===========================================
PAPERLESS_LLM_OCR_DAILY_PAGE_LIMIT=unlimited
PAPERLESS_LLM_OCR_RUN_PAGE_LIMIT=unlimited
PAPERLESS_LLM_OCR_DAILY_TOKEN_LIMIT=unlimited
PAPERLESS_LLM_OCR_RUN_TOKEN_LIMIT=unlimited

# ===========================================
# Production Safety
# ===========================================
# Blocks mutating API requests and disables startup processing jobs.
PAPERLESS_LLM_PROD_READ_ONLY=false
