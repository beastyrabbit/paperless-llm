# Production read-only run template.
# Copy to .env.prod.local and fill local secrets there. .env.prod.local is ignored.

# Hard guard: the backend and web proxy block mutating API requests when true.
PAPERLESS_LLM_PROD_READ_ONLY=true

# Fail fast if required external-service secrets are missing.
PAPERLESS_LLM_REQUIRE_SECRETS=true

# These values are injected from the Infisical prod environment. They are
# listed here only as the required runtime contract for manual fallback use.
PAPERLESS_URL=https://paperless.example.com
PAPERLESS_TOKEN=replace-with-production-paperless-token
OLLAMA_URL=http://ollama.internal.example:11434
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:8b
QDRANT_URL=http://qdrant.internal.example:6333
QDRANT_COLLECTION=paperless-documents
QDRANT_EMBEDDING_DIMENSION=4096
PAPERLESS_LLM_MUTATION_MODE=paperless_first
PAPERLESS_LLM_AI_ANALYSE_SCANNER_SCOPE=disabled
PAPERLESS_LLM_AI_ANALYSE_TAG_ID=115

# Point the backend at an absolute, ignored config file with production keys.
# Example: /mnt/storage/workspace/projects/paperless_local_llm/config.yaml
PAPERLESS_LLM_CONFIG=/absolute/path/to/config.yaml

# Protect outbound Paperless calls from accidental host drift.
# Use only the production Paperless hostname, without scheme or path.
PAPERLESS_ALLOWED_HOSTS=paperless.example.com

# Shared token used by the web proxy to authenticate to the backend.
PAPERLESS_LLM_API_TOKEN=replace-with-a-local-random-token

# OCR provider settings. Keep the real key in ignored local files only.
MISTRAL_API_KEY=replace-with-production-mistral-key
MISTRAL_MODEL=mistral-ocr-latest
MISTRAL_API_BASE_URL=https://api.mistral.ai

# Codex runtime. Leave disabled for read-only production smoke unless the
# persisted CODEX_HOME volume contains a valid auth.json.
CODEX_CLI_VERSION=0.145.0
CODEX_HOME=/app/codex-home
PAPERLESS_LLM_CODEX_ENABLED=false
PAPERLESS_LLM_CODEX_AUTH_REQUIRED=false
PAPERLESS_LLM_MISTRAL_ENABLED=false
PAPERLESS_LLM_MISTRAL_AUTH_REQUIRED=false

# Durable backend state and single-writer guard.
PAPERLESS_LLM_TINYBASE_DATA_DIR=/app/data/tinybase
PAPERLESS_LLM_OPERATIONAL_LEDGER_DATA_DIR=/app/data/operational-ledger
PAPERLESS_LLM_BACKEND_WRITER_LOCK_ENABLED=true
PAPERLESS_LLM_CONTAINER_CHECKS_ENABLED=true

# Runtime limits.
PAPERLESS_LLM_AGENT_PROMPT_TIMEOUT_MS=120000
PAPERLESS_LLM_HTTP_TIMEOUT_MS=120000
PAPERLESS_LLM_MISTRAL_RETRY_ATTEMPTS=3
PAPERLESS_LLM_MISTRAL_RETRY_BASE_DELAY_MS=5000
PAPERLESS_LLM_OLLAMA_MAX_CONCURRENT=1
PAPERLESS_LLM_MISTRAL_MAX_CONCURRENT=1
PAPERLESS_LLM_OCR_MAX_CONCURRENT=1
PAPERLESS_LLM_OCR_DAILY_PAGE_LIMIT=unlimited
PAPERLESS_LLM_OCR_RUN_PAGE_LIMIT=unlimited
PAPERLESS_LLM_OCR_DAILY_TOKEN_LIMIT=unlimited
PAPERLESS_LLM_OCR_RUN_TOKEN_LIMIT=unlimited

# Frontend proxy target. For local Portless, keep this value.
BACKEND_URL=https://paperless-llm-api.localhost:1355

# Browser origins allowed to call the backend directly.
PAPERLESS_LLM_TRUSTED_UI_ORIGINS=https://paperless-llm-web.localhost:1355
