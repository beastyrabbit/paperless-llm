# Production read-only run template.
# Copy to .env.prod.local and fill local secrets there. .env.prod.local is ignored.

# Hard guard: the backend and web proxy block mutating API requests when true.
PAPERLESS_LLM_PROD_READ_ONLY=true

# Fail fast if required external-service secrets are missing.
PAPERLESS_LLM_REQUIRE_SECRETS=true

# Point the backend at an absolute, ignored config file with production keys.
# Example: /mnt/storage/workspace/projects/paperless_local_llm/config.yaml
PAPERLESS_LLM_CONFIG=/absolute/path/to/config.yaml

# Protect outbound Paperless calls from accidental host drift.
# Use only the production Paperless hostname, without scheme or path.
PAPERLESS_ALLOWED_HOSTS=paperless.example.com

# Shared token used by the web proxy to authenticate to the backend.
PAPERLESS_LLM_API_TOKEN=replace-with-a-local-random-token

# Frontend proxy target. For local Portless, keep this value.
BACKEND_URL=https://paperless-llm-api.localhost:1355

# Browser origins allowed to call the backend directly.
PAPERLESS_LLM_TRUSTED_UI_ORIGINS=https://paperless-llm-web.localhost:1355
